{
  "name": "agent-backbone",
  "version": "0.12.1",
  "description": "Keep coding agents' skills, MCP servers, hooks, instructions and settings in sync from one Git repository.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notsuhas/agent-backbone.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run test:built",
    "prepack": "npm run build",
    "test:built": "node --test dist/tests/*.js"
  },
  "dependencies": {
    "commander": "^14.0.1",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.9.1",
    "yaml": "^2.9.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "esbuild": "^0.25.11",
    "typescript": "^5.9.3"
  },
  "files": [
    "bin/agent-backbone",
    "dist/cli.js",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ]
}
